fn is_prime(n: int) bool {
    if n < 2 {
        return false;
    }
    is_p = true;
    for i = 2; i <= 1000; i += 1 {
        if i * i <= n {
            if n - (n / i) * i == 0 {
                is_p = false;
            }
        }
    }
    return is_p;
}

fn fib(n: int) int {
    if n <= 1 {
        return n;
    }
    return fib(n: n - 1) + fib(n: n - 2);
}

fn fact(n: int) int {
    if n <= 1 {
        return 1;
    }
    return n * fact(n: n - 1);
}

fn gcd(a: int, b: int) int {
    x = a;
    y = b;
    while y != 0 {
        temp = y;
        y = x - (x / y) * y;
        x = temp;
    }
    return x;
}

fn sum_to_n(n: int) int {
    total = 0;
    for i = 1; i <= n; i += 1 {
        total += i;
    }
    return total;
}

fn max3(a: int, b: int, c: int) int {
    m = a;
    if b > m {
        m = b;
    }
    if c > m {
        m = c;
    }
    return m;
}

fn clamp(x: int, lo: int, hi: int) int {
    if x < lo {
        return lo;
    } else if x > hi {
        return hi;
    } else {
        return x;
    }
}

fn collatz_len(n: int) int {
    steps = 0;
    cur = n;
    while cur != 1 {
        half = cur / 2;
        if cur - half * 2 == 0 {
            cur = half;
        } else {
            cur = cur * 3 + 1;
        }
        steps += 1;
    }
    return steps;
}

