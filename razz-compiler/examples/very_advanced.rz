fn add(a: int, b: int) int {
    return a + b; 
}

fn main() null {
    // This is a comment, -> means access the json object 
    // Type can be inferred 
    cam = GET /camera;
    cam->vfov = 5.0; 
    // Adjust camera angle 
    PATCH /camera Camera { vfov: cam->vfov };

    color = Color {
        r: add(b:3, a: 2), 
        g: 5, 
        b: 5, 
    };

    // Type can be specified 
    // Some types like the background or camera is in the language itself
    background: Background = GET /background; 
    background->top = Vec3 { x: 0.2, y: 0.4, z: 0.6 };
    background->bottom = Vec3 { x: 0.0, y: 0.0, z: 0.0 };

    PUT /background Background {
        top: background->top,
        bottom: background->bottom
    };
    a = 255; 
    for i = 2; i < 100; i += 1 {
        a += -i; 
    }
    // can't access i here 
    b: bool = false; 
    if a > 100 {
        color->g = a; 
    } else if a < 50 && a >= 20 || (a == 99 && !b){
        color->b = 1; 
    }
    else {
        color->r = 2; 
    }
    color->g = add (a: 100,
        b: -1
    ); 

    coord = Vec3 {
        x: 1.0,
        y: 2.0, 
        z: 3.0, 
    };

    POST /hittable Sphere {
        coord: coord,
        radius: 0.5,
        material: Lambertian { albedo: color }
    }; 
    
    PATCH /output Output {
        file: "test.ppm"
    }; 
    return null;
}
