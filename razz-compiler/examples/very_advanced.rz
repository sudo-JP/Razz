fn add(a: int, b: int) int {
    return a + b; 
}

fn main() null {
    // This is a comment, -> means access the json object 
    // Type can be inferred 
    cam = GET /camera;
    cam->vfov = 5.0; 
    // Adjust camera angle 
    PATCH /camera Camera cam;

    color = Color {
        r: add(b:3, a: 2), 
        g: 5, 
        b: 5, 
    };

    // Type can be specified 
    // Some types like the background or camera is in the language itself
    background: Background = GET /background; 
    background->top = color;
    background->bottom = Color { r: 255, g: 255, b: 255 };

    PUT /background Background background;
    a = 255; 
    for i = 2; i < 100; i += 1 {
        a += -i; 
    }
    // can't access i here 
    b: bool = false; 
    if a > 100 {
        color->g = a; 
    } else if a < 50 && a >= 20 || (a == 99 && !b){
        color->b = 1; 
    }
    else {
        color->r = 2; 
    }
    color->g = add (a: 100,
        b: -1
    ); 

    coord = Vec3 {
        x: 1,
        y: 2, 
        z: 3, 
    };

    POST /hittable Sphere {
        coord: coord,
        radius: 0.5,
        color: color,
    }; 
    
    PATCH /output Output {
        type: PPM,
        file: "test.ppm"
    }; 


    PATCH /output Output {
        type: Arduino,
        file: "test.ppm" // Ignored? 
    }; 
}
