fn foo() null {
    POST /hittable Sphere { coord: Vec3 { x: 1, y: 2, z: 3 }, radius: 0.5, material: Lambertian { } };
    PUT /camera Camera { lookfrom: Vec3 { x: 1, y: 2, z: 3 }, lookat: Vec3 { x: 0, y: 0, z: 0 }, vfov: 90, vup: Vec3 { x: 0, y: 1, z: 0 }, focus_dist: 1, defocus_angle: 0 };
    PATCH /background Background { top: Vec3 { x: 1, y: 1, z: 1 }, bottom: Vec3 { x: 0, y: 0, z: 0 } };
}
